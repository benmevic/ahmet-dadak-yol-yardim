---
import { business } from '../data/business';
import { whatsappHref, DEFAULT_WA_MESSAGE } from '../lib/contact';
import MapPin from './icons/MapPin.astro';

interface Props {
  block?: boolean;
}

const { block = false } = Astro.props;
---
<a
  class:list={['wa-button', { 'wa-button--block': block }]}
  href={whatsappHref(business.phoneE164, DEFAULT_WA_MESSAGE)}
  target="_blank"
  rel="noopener"
>
  <MapPin size={20} />
  <span>Konumu WhatsApp'tan gönder</span>
</a>

<style>
  .wa-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 56px;
    padding: 0 20px;
    border: 2px solid var(--ink);
    border-radius: 8px;
    background: transparent;
    color: var(--ink);
    font: 600 0.9375rem/1.2 var(--font-body);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 160ms cubic-bezier(0.16, 1, 0.3, 1),
      color 160ms cubic-bezier(0.16, 1, 0.3, 1);
    -webkit-tap-highlight-color: transparent;
  }

  .wa-button--block {
    display: flex;
    width: 100%;
  }

  @media (hover: hover) {
    .wa-button:hover {
      background: var(--ink);
      color: #fff;
    }
  }

  .wa-button:active {
    background: var(--ink);
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-button {
      transition: none;
    }
  }
</style>
