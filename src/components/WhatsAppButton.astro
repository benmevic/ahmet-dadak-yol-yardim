---
import { business } from '../data/business';
import { whatsappHref, DEFAULT_WA_MESSAGE } from '../lib/contact';
import WhatsApp from './icons/WhatsApp.astro';

interface Props {
  block?: boolean;
}

const { block = false } = Astro.props;
---
<a
  class:list={['wa-button', { 'wa-button--block': block }]}
  href={whatsappHref(business.phoneE164, DEFAULT_WA_MESSAGE)}
  target="_blank"
  rel="noopener"
>
  <WhatsApp size={22} />
  <span>Konumu WhatsApp'tan gönder</span>
</a>

<style>
  .wa-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 56px;
    padding: 0 20px;
    border: 2px solid var(--wa-green);
    border-radius: 10px;
    background: var(--wa-green);
    box-shadow: 0 10px 22px -14px rgb(18 140 74 / 0.9);
    color: var(--ink);
    font: 700 0.9375rem/1.2 var(--font-body);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--duration-quick) var(--ease-smooth-out),
      color var(--duration-quick) var(--ease-smooth-out),
      transform var(--duration-quick) var(--ease-smooth-out);
    -webkit-tap-highlight-color: transparent;
  }

  .wa-button--block {
    display: flex;
    width: 100%;
  }

  @media (hover: hover) {
    .wa-button:hover {
      background: var(--wa-green-press);
      border-color: var(--wa-green-press);
      transform: translateY(-1px);
    }
  }

  .wa-button:active {
    background: var(--wa-green-press);
    border-color: var(--wa-green-press);
    transform: translateY(1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-button {
      transition: none;
    }
  }
</style>
