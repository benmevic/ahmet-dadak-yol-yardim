---
import { business } from '../data/business';
import { telHref, whatsappHref, DEFAULT_WA_MESSAGE } from '../lib/contact';
import Phone from './icons/Phone.astro';
import WhatsApp from './icons/WhatsApp.astro';
import MapPin from './icons/MapPin.astro';
import Instagram from './icons/Instagram.astro';

const year = new Date().getFullYear();

const links = [
  { label: 'Hizmetler', href: '/hizmetler/' },
  { label: 'İlçeler', href: '/izmir/' },
  { label: 'Nasıl çalışıyoruz', href: '/#nasil' },
  { label: 'İletişim', href: '/iletisim/' },
];
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-lead">
      <p class="footer-name">{business.name}</p>
      <p class="footer-note">İzmir'in her ilçesinde {business.hours} çekici ve yol yardım.</p>
    </div>

    <div class="footer-col">
      <h2>İletişim</h2>
      <ul>
        <li>
          <a class="footer-phone" href={telHref(business.phoneE164)}>
            <Phone size={18} />
            <span>{business.phoneDisplay}</span>
          </a>
        </li>
        <li>
          <a
            href={whatsappHref(business.phoneE164, DEFAULT_WA_MESSAGE)}
            target="_blank"
            rel="noopener"
          >
            <span class="brand-chip brand-chip--wa"><WhatsApp size={16} /></span>
            <span>WhatsApp'tan yazın</span>
          </a>
        </li>
        <li>
          <a href={business.instagramUrl} target="_blank" rel="noopener">
            <span class="brand-chip brand-chip--insta"><Instagram size={16} /></span>
            <span>Instagram: @{business.instagramHandle}</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="footer-col">
      <h2>Adres</h2>
      <ul>
        {
          business.addresses.map((a) => (
            <li class="footer-address">
              <MapPin size={18} />
              <address>{a.postalLine}</address>
            </li>
          ))
        }
      </ul>
    </div>

    <nav class="footer-col" aria-label="Alt menü">
      <h2>Sayfalar</h2>
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <p class="footer-legal">© {year} {business.name}. Gece gündüz, haftanın her günü açığız.</p>
</footer>

<style>
  .site-footer {
    background: linear-gradient(180deg, var(--ground) 0, #2a2b31 150px, var(--night) 260px);
    color: #fff;
  }

  .footer-inner {
    display: grid;
    gap: 28px;
    padding: 150px 16px 28px;
  }

  p {
    margin: 0;
  }

  .footer-name {
    font: 700 1.375rem/1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .footer-note {
    margin-top: 8px;
    max-width: 32ch;
    color: #b8bbc4;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  h2 {
    margin: 0 0 10px;
    font: 700 0.9375rem/1.2 var(--font-display);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--gold-light);
  }

  ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.3);
    text-decoration-thickness: 2px;
    transition: text-decoration-color 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  a:hover {
    text-decoration-color: var(--gold-light);
  }

  .footer-phone {
    font: 700 1.5rem/1 var(--font-display);
    letter-spacing: 0.03em;
    text-decoration: none;
  }

  .brand-chip {
    display: grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 8px;
  }

  .brand-chip--wa {
    background: var(--wa-green);
    color: var(--ink);
  }

  .brand-chip--insta {
    background: var(--insta-gradient);
    color: #fff;
  }

  .footer-address {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .footer-address :global(svg) {
    flex: none;
    margin-top: 1px;
    color: var(--gold-light);
  }

  address {
    font-style: normal;
  }

  .footer-legal {
    padding: 16px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    color: #b8bbc4;
    font-size: 0.8125rem;
  }

  @media (max-width: 767px) {
    .site-footer {
      padding-bottom: calc(70px + env(safe-area-inset-bottom));
    }
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 1.3fr 1fr 1fr;
      padding: 170px 32px 36px;
    }

    .footer-lead {
      grid-column: 1 / -1;
    }

    .footer-legal {
      padding: 16px 32px;
    }
  }

  @media (min-width: 1024px) {
    .footer-inner {
      grid-template-columns: 1.4fr 1fr 1.2fr 0.8fr;
    }

    .footer-lead {
      grid-column: auto;
    }
  }
</style>
