---
import { Picture } from 'astro:assets';
import { jobs } from '../data/jobs';
import { business } from '../data/business';
import Instagram from './icons/Instagram.astro';

interface Props {
  heading?: string;
}

const { heading = 'Son taşıdıklarımız' } = Astro.props;
// Each copy of the list is one full lap of the loop.
const laps = [false, true];
---
<section class="jobs" aria-labelledby="jobs-title" data-jobs>
  <div class="jobs-head wrap">
    <h2 id="jobs-title" class="section-title">{heading}</h2>
    <div class="jobs-tools">
      <a class="jobs-insta" href={business.instagramUrl} target="_blank" rel="noopener">
        <span class="jobs-insta-icon"><Instagram size={18} /></span>
        <span>Tümü Instagram'da: <b>@{business.instagramHandle}</b></span>
      </a>
      <button class="jobs-pause" type="button" aria-pressed="false" data-jobs-pause>
        <span class="jobs-pause-icon" aria-hidden="true"></span>
        <span class="jobs-pause-label">Durdur</span>
      </button>
    </div>
  </div>
  <div class="jobs-viewport" tabindex="0" role="region" aria-label="Son taşıdıklarımız, yana kaydırın">
    <div class="jobs-loop">
      {
        laps.map((clone) => (
          <ul
            class="jobs-row"
            {...(clone
              ? { 'aria-hidden': 'true', 'data-clone': '' }
              : {})}
          >
            {jobs.map((job) => (
              <li class="job">
                <Picture
                  src={job.image}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  widths={[320, 480, 640]}
                  sizes="(min-width: 768px) 320px, 70vw"
                  loading="lazy"
                  alt={clone ? '' : job.alt}
                />
                <p>
                  <b>{job.vehicle}</b>
                  <span>{job.place}</span>
                </p>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>
<script is:inline>
  (() => {
    document.querySelectorAll('[data-jobs]').forEach((s) => {
      const b = s.querySelector('[data-jobs-pause]');
      if (!b) return;
      b.addEventListener('click', () => {
        const p = s.classList.toggle('is-paused');
        b.setAttribute('aria-pressed', String(p));
        b.querySelector('.jobs-pause-label').textContent = p ? 'Oynat' : 'Durdur';
      });
    });
  })();
</script>

<style>
  .jobs {
    padding: 30px 0 34px;
  }

  .jobs-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px 20px;
  }

  .jobs-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
  }

  .jobs-insta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--ink);
    font: 600 0.875rem/1.3 var(--font-body);
    text-decoration: none;
  }

  .jobs-insta-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--insta-gradient);
    color: #fff;
  }

  .jobs-insta b {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: #b02f7c;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .jobs-pause {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--panel);
    color: var(--ink);
    font: 600 0.875rem/1 var(--font-body);
    cursor: pointer;
  }

  .jobs-pause-icon {
    width: 10px;
    height: 12px;
    border-inline: 3px solid currentColor;
    box-sizing: border-box;
  }

  .jobs.is-paused .jobs-pause-icon {
    border: none;
    border-left: 10px solid currentColor;
    border-block: 6px solid transparent;
  }

  .jobs-viewport {
    margin-top: 18px;
    overflow: hidden;
    /* Photos fade in and out at the screen edges. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .jobs-loop {
    display: flex;
    width: max-content;
  }

  .jobs-row {
    display: flex;
    gap: 14px;
    margin: 0;
    padding: 4px 14px 8px 0;
    list-style: none;
  }

  .jobs-viewport:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: -3px;
  }

  .job {
    flex: 0 0 clamp(220px, 68vw, 320px);
  }

  .job :global(picture) {
    display: block;
    overflow: hidden;
    border-radius: 18px;
    box-shadow: var(--card-shadow);
  }

  .job :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--line);
    transition: scale var(--duration-very-slow) var(--ease-smooth-out);
  }

  .job p {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  .job b {
    display: block;
    color: var(--ink);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  @media (hover: hover) {
    .job:hover :global(img) {
      scale: 1.04;
    }
  }

  /* The loop: two identical lists slide left by one list's width, forever.
     It rests while the pointer or keyboard is on it, and on "Durdur". */
  @media (prefers-reduced-motion: no-preference) {
    .jobs-loop {
      animation: jobs-loop 60s linear infinite;
    }

    .jobs-viewport:hover .jobs-loop,
    .jobs-viewport:focus-within .jobs-loop,
    .jobs.is-paused .jobs-loop {
      animation-play-state: paused;
    }
  }

  @keyframes jobs-loop {
    to {
      transform: translateX(-50%);
    }
  }

  /* Without motion: one list, scrolled by hand. */
  @media (prefers-reduced-motion: reduce) {
    .jobs-viewport {
      overflow-x: auto;
      scroll-snap-type: x proximity;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .jobs-row[data-clone],
    .jobs-pause {
      display: none;
    }

    .jobs-row {
      padding-left: 16px;
    }

    .job {
      scroll-snap-align: start;
    }

    .job :global(img) {
      transition: none;
    }
  }

  @media (min-width: 768px) {
    .jobs {
      padding: 44px 0 48px;
    }

    .jobs-viewport {
      margin-top: 24px;
    }
  }
</style>
