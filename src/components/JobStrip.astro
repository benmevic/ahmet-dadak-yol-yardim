---
import { Picture } from 'astro:assets';
import { jobs } from '../data/jobs';
import { business } from '../data/business';
import Instagram from './icons/Instagram.astro';

interface Props {
  limit?: number;
  heading?: string;
}

const { limit = 5, heading = 'Son taşıdıklarımız' } = Astro.props;
const shown = jobs.slice(0, limit);
---
<section class="jobs" aria-labelledby="jobs-title">
  <div class="jobs-head wrap">
    <h2 id="jobs-title" class="section-title">{heading}</h2>
    <a class="jobs-insta" href={business.instagramUrl} target="_blank" rel="noopener">
      <span class="jobs-insta-icon"><Instagram size={18} /></span>
      <span>Tümü Instagram'da: <b>@{business.instagramHandle}</b></span>
    </a>
  </div>
  <ul class="jobs-row wrap" tabindex="0" aria-label="Son taşıdıklarımız, yana kaydırın">
    {
      shown.map((job) => (
        <li class="job">
          <Picture
            src={job.image}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 20vw, (min-width: 768px) 30vw, 46vw"
            loading="lazy"
            alt={job.alt}
          />
          <p>
            <b>{job.vehicle}</b>
            <span>{job.place}</span>
          </p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .jobs {
    background: transparent;
    padding: 26px 0 30px;
  }

  .jobs-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 20px;
  }

  .jobs-insta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--ink);
    font: 600 0.875rem/1.3 var(--font-body);
    text-decoration: none;
  }

  .jobs-insta-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--insta-gradient);
    color: #fff;
  }

  .jobs-insta b {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: #b02f7c;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .jobs-row {
    display: flex;
    gap: 10px;
    margin-top: 14px;
    margin-bottom: 0;
    padding-block: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 16px;
    scrollbar-width: none;
  }

  .jobs-row::-webkit-scrollbar {
    display: none;
  }

  .job {
    flex: 0 0 clamp(150px, 46vw, 220px);
    scroll-snap-align: start;
  }

  .job :global(picture) {
    display: block;
  }

  .job :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 16px;
    background: var(--line);
    box-shadow: var(--card-shadow);
  }

  .job p {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  .job b {
    display: block;
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .jobs {
      padding: 34px 0 40px;
    }

    .jobs-row {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 14px;
      margin-top: 18px;
      overflow: visible;
    }

    .job {
      flex: none;
    }
  }

  @media (min-width: 1024px) {
    .jobs-row {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .job {
        animation: job-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 55%;
      }
    }
  }

  @keyframes job-rise {
    from {
      opacity: 0.55;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
