---
import { business } from '../data/business';
import { telHref, whatsappHref, DEFAULT_WA_MESSAGE } from '../lib/contact';
import Phone from './icons/Phone.astro';
import WhatsApp from './icons/WhatsApp.astro';
---
<div class="sticky-actions">
  <a class="sticky-call" href={telHref(business.phoneE164)}>
    <Phone size={20} />
    <span>Ara</span>
  </a>
  <a
    class="sticky-wa"
    href={whatsappHref(business.phoneE164, DEFAULT_WA_MESSAGE)}
    target="_blank"
    rel="noopener"
  >
    <WhatsApp size={20} />
    <span>WhatsApp</span>
  </a>
</div>
<script is:inline>
  (() => {
    const bar = document.querySelector('.sticky-actions');
    const targets = document.querySelectorAll('[data-primary-cta]');
    if (!bar || !targets.length || !('IntersectionObserver' in window)) return;
    const seen = new Set();
    const set = () => bar.classList.toggle('is-tucked', seen.size > 0);
    targets.forEach((el) => {
      const r = el.getBoundingClientRect();
      if (r.bottom > 0 && r.top < innerHeight) seen.add(el);
    });
    set();
    requestAnimationFrame(() => bar.classList.add('is-ready'));
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)));
      set();
    });
    targets.forEach((el) => io.observe(el));
  })();
</script>

<style>
  .sticky-actions {
    position: fixed;
    inset: auto 0 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
    background: var(--panel);
    border-top: 1px solid var(--line);
    box-shadow: 0 -8px 20px -14px rgb(20 21 24 / 0.4);
  }

  .sticky-actions.is-ready {
    transition:
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 0s;
  }

  .sticky-actions.is-tucked {
    transform: translateY(100%);
    visibility: hidden;
  }

  .sticky-actions.is-ready.is-tucked {
    transition:
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 220ms;
  }

  .sticky-actions a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    border-radius: 8px;
    font: 700 1.125rem/1 var(--font-display);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .sticky-call {
    background: var(--red);
    color: #fff;
    border: 2px solid var(--red);
  }

  .sticky-call:active {
    background: #a51117;
    border-color: #a51117;
  }

  .sticky-wa {
    background: var(--wa-green);
    color: var(--ink);
    border: 2px solid var(--wa-green);
  }

  .sticky-wa:active {
    background: var(--wa-green-press);
    border-color: var(--wa-green-press);
  }

  @media (min-width: 768px) {
    .sticky-actions {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-actions.is-ready,
    .sticky-actions.is-ready.is-tucked {
      transition: none;
    }
  }
</style>
