---
import { Picture } from 'astro:assets';
import logo from '../assets/logo.jpg';
import { business } from '../data/business';
import Instagram from './icons/Instagram.astro';

interface Props {
  path: string;
}

const { path } = Astro.props;

const links = [
  { label: 'Hizmetler', href: '/hizmetler/' },
  { label: 'İlçeler', href: '/izmir/' },
  { label: 'Nasıl çalışıyoruz', href: '/#nasil' },
  { label: 'İletişim', href: '/iletisim/' },
  { label: 'Instagram', href: business.instagramUrl, external: true },
];

const isCurrent = (href: string) => href !== '/' && !href.includes('#') && path.startsWith(href);
---
<header class="site-header">
  <a class="brand" href="/">
    <Picture
      src={logo}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      width={48}
      height={48}
      densities={[1, 2]}
      alt=""
      loading="eager"
    />
    <span class="brand-text">
      <span class="brand-name">Ahmet Dadak<span class="wide"> Yol Yardım</span></span>
      <span class="brand-sub">
        <span class="wide">İzmir geneli · 7/24 çekici</span>
        <span class="narrow">Yol Yardım · 7/24</span>
      </span>
    </span>
  </a>
  <nav class="site-nav" aria-label="Ana menü">
    <ul>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class:list={{ 'nav-insta': link.external }}
              {...(link.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              {link.external && (
                <span class="nav-insta-icon">
                  <Instagram size={15} />
                </span>
              )}
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <a
    class="header-insta"
    href={business.instagramUrl}
    target="_blank"
    rel="noopener"
    aria-label={`Instagram: @${business.instagramHandle}`}
  >
    <Instagram size={22} />
  </a>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 10px 16px;
    background: var(--panel);
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    min-width: 0;
  }

  .brand :global(img) {
    display: block;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    flex: none;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .brand-name {
    font: 700 1rem/1 var(--font-display);
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .brand-sub {
    font: 500 0.75rem/1.2 var(--font-body);
    color: var(--muted);
  }

  .wide {
    display: none;
  }

  .site-nav {
    display: none;
  }

  .site-nav ul {
    display: flex;
    gap: 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: inline-block;
    padding: 6px 0 2px;
    border-bottom: 2px solid transparent;
    color: var(--ink);
    font: 600 0.875rem/1.2 var(--font-body);
    text-decoration: none;
    transition: border-color 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-nav a.nav-insta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .nav-insta-icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: var(--insta-gradient);
    color: #fff;
  }

  .header-insta {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    background: var(--insta-gradient);
    color: #fff;
    -webkit-tap-highlight-color: transparent;
  }

  .header-insta:active {
    filter: brightness(0.85);
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    border-bottom-color: var(--red);
  }

  @media (min-width: 768px) {
    .site-header {
      padding: 14px 32px;
    }

    .brand {
      gap: 12px;
    }

    .brand :global(img) {
      width: 44px;
      height: 44px;
    }

    .brand-name {
      font-size: 1.3125rem;
    }

    .brand-sub {
      font-size: 0.8125rem;
    }

    .wide {
      display: inline;
    }

    .narrow {
      display: none;
    }

    .site-nav {
      display: block;
    }

    .header-insta {
      display: none;
    }
  }

  @media (min-width: 768px) and (max-width: 899px) {
    .site-nav ul {
      gap: 18px;
    }
  }
</style>
