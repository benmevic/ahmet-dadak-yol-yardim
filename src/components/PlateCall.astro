---
import { business } from '../data/business';
import { telHref } from '../lib/contact';
import Phone from './icons/Phone.astro';

interface Props {
  size?: 'lg' | 'md';
  [attr: `data-${string}`]: unknown;
}

const { size = 'lg', ...attrs } = Astro.props;
---
<a
  class:list={['plate', `plate--${size}`]}
  href={telHref(business.phoneE164)}
  aria-label={`${business.phoneDisplay} numarasını ara`}
  {...attrs}
>
  <span class="plate-strip">
    <Phone size={size === 'lg' ? 16 : 14} />
    <span class="plate-country">TR</span>
  </span>
  <span class="plate-face">
    <span class="plate-digits">{business.phoneDisplay}</span>
    <span class="plate-hint">Dokunun, hemen arayın</span>
  </span>
</a>

<style>
  .plate {
    --plate-digits: 2.5rem;
    display: inline-flex;
    align-items: stretch;
    background: var(--panel);
    color: var(--ink);
    border: 3px solid var(--ink);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    box-shadow:
      0 2px 0 rgb(22 23 27 / 0.1),
      0 14px 28px -14px rgb(22 23 27 / 0.6);
    transition:
      transform 160ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 160ms cubic-bezier(0.16, 1, 0.3, 1);
    -webkit-tap-highlight-color: transparent;
  }

  .plate--md {
    --plate-digits: 1.875rem;
    border-width: 2px;
    border-radius: 6px;
  }

  .plate-strip {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    padding: 10px 10px 8px;
    background: var(--blue);
    color: #fff;
    font: 700 0.8125rem/1 var(--font-display);
    letter-spacing: 0.06em;
  }

  .plate-face {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 10px 18px 9px;
    min-width: 0;
  }

  .plate-digits {
    font: 700 var(--plate-digits) / 1 var(--font-display);
    letter-spacing: 0.03em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .plate-hint {
    margin-top: 5px;
    font: 600 0.75rem/1.2 var(--font-body);
    letter-spacing: 0.02em;
    color: var(--red);
  }

  .plate--md .plate-face {
    padding: 7px 14px 6px;
  }

  .plate--md .plate-hint {
    margin-top: 3px;
    font-size: 0.6875rem;
  }

  @media (hover: hover) {
    .plate:hover {
      transform: translateY(-1px);
      box-shadow:
        0 3px 0 rgb(20 21 24 / 0.1),
        0 14px 28px -12px rgb(20 21 24 / 0.55);
    }
  }

  .plate:active {
    transform: translateY(1px);
    box-shadow:
      0 1px 0 rgb(20 21 24 / 0.08),
      0 6px 14px -10px rgb(20 21 24 / 0.45);
  }

  @media (prefers-reduced-motion: reduce) {
    .plate {
      transition: none;
    }
  }
</style>
