---
const steps = [
  { title: 'Arayın', text: 'Bizi arayın, aracınızın durumunu söyleyin.' },
  { title: 'Konumunuzu gönderin', text: "WhatsApp'tan konumunuzu paylaşın, sizi bulalım." },
  {
    title: 'Aracınızı istediğiniz yere bırakalım',
    text: 'Aracınızı çekiciyle söylediğiniz adrese götürürüz.',
  },
];
---
<section id="nasil" class="how" aria-labelledby="how-title">
  <div class="wrap">
    <h2 id="how-title" class="section-title">Nasıl çalışıyoruz</h2>
    <ol class="steps">
      {
        steps.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how {
    padding: 34px 0 38px;
    scroll-margin-top: 72px;
  }

  .steps {
    display: grid;
    gap: 22px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    position: relative;
    padding: 12px 0 0 56px;
    border-top: 2px solid var(--ink);
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 6px;
    font: 700 2.75rem/1 var(--font-display);
    color: var(--red);
    font-variant-numeric: tabular-nums;
  }

  h3 {
    margin: 0;
    font: 700 1.375rem/1.05 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }

  p {
    margin: 6px 0 0;
    max-width: 34ch;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.45;
  }

  @media (min-width: 768px) {
    .how {
      padding: 52px 0 56px;
    }

    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
      margin-top: 28px;
    }

    .steps li {
      padding: 16px 0 0;
    }

    .steps li::before {
      position: static;
      display: block;
      margin-bottom: 10px;
      font-size: 3.5rem;
    }

    h3 {
      font-size: 1.625rem;
    }
  }
</style>
