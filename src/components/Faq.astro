---
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---
<div class="faq">
  {
    items.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    padding: 4px 20px;
    border-radius: 20px;
    background: var(--panel);
    box-shadow: var(--card-shadow);
  }

  details + details {
    border-top: 1px solid var(--line);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    padding: 10px 0;
    cursor: pointer;
    list-style: none;
    font: 600 1.0625rem/1.3 var(--font-body);
    color: var(--ink);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '';
    flex: none;
    width: 10px;
    height: 10px;
    margin-right: 4px;
    border-right: 2.5px solid var(--red);
    border-bottom: 2.5px solid var(--red);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  details[open] summary::after {
    transform: rotate(225deg);
  }

  p {
    margin: 0;
    padding: 0 0 18px;
    max-width: 62ch;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    summary::after {
      transition: none;
    }
  }
</style>
