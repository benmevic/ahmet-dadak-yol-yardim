---
import raw from '../assets/izmir-ilceler.svg?raw';

interface Props {
  highlight: string[];
}

const { highlight } = Astro.props;
const live = new Set(highlight);

const viewBox = raw.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 1000 1000';
const districts = [...raw.matchAll(/<path data-ilce="([^"]+)" data-name="([^"]+)" data-cx="([^"]+)" data-cy="([^"]+)" d="([^"]*)"/g)].map(
  (m) => ({ slug: m[1]!, name: m[2]!, cx: m[3]!, cy: m[4]!, d: m[5]! }),
);
const inactive = districts.filter((d) => !live.has(d.slug));
const active = districts.filter((d) => live.has(d.slug));
---
<figure class="izmir-map">
  <svg
    data-izmir-map
    viewBox={viewBox}
    role="img"
    aria-label={`İzmir ilçe haritası. Hizmet verdiğimiz ilçeler: ${active.map((d) => d.name).join(', ')}.`}
  >
    {
      inactive.map((d) => (
        <path class="d" data-ilce={d.slug} d={d.d}>
          <title>{d.name}</title>
        </path>
      ))
    }
    {
      active.map((d) => (
        <path class="d d--live" data-ilce={d.slug} data-live d={d.d}>
          <title>{d.name}</title>
        </path>
      ))
    }
    {
      active.map((d, i) => (
        <text class="label" x={d.cx} y={Number(d.cy) + (i % 2 === 0 ? -14 : 30)} text-anchor="middle" aria-hidden="true">
          {d.name}
        </text>
      ))
    }
  </svg>
  <figcaption>© OpenStreetMap katkıda bulunanlar</figcaption>
</figure>

<style>
  .izmir-map {
    margin: 0;
  }

  svg {
    width: 100%;
    height: auto;
  }

  .d {
    fill: var(--line);
    stroke: var(--panel);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .d--live {
    fill: var(--red);
    fill-opacity: 0.85;
  }

  .label {
    font: 700 34px var(--font-display);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    fill: #fff;
    stroke: var(--ink);
    stroke-width: 5px;
    stroke-opacity: 0.55;
    paint-order: stroke;
    pointer-events: none;
  }

  figcaption {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.3;
  }
</style>
