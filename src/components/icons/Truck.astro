---
// Flatbed tow truck, stroke style to match Phone and MapPin.
interface Props {
  size?: number;
  class?: string;
}

const { size = 20, class: className } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M2 16V9.5A1.5 1.5 0 0 1 3.5 8H8l2.5 3.5H11v4.5" />
  <path d="M11 13h11v3" />
  <path d="M13 13l2-3h5" />
  <circle cx="6" cy="17.5" r="1.8" />
  <circle cx="17.5" cy="17.5" r="1.8" />
  <path d="M7.8 17.5h7.9" />
</svg>
