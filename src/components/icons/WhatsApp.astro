---
interface Props {
  size?: number;
  class?: string;
}

const { size = 20, class: className } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M3.5 20.5l1.3-4.2A9 9 0 1 1 8 19.6z" />
  <path d="M9.2 8.4c0 3.6 2.8 6.4 6.4 6.4l.9-1.6-2-1-1 .9a4.6 4.6 0 0 1-2.1-2.1l.9-1-1-2z" />
</svg>
