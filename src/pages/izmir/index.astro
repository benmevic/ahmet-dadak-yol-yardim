---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { jobs } from '../../data/jobs';
import PlateCall from '../../components/PlateCall.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import { liveIlceler, ilcePath } from '../../lib/ilce';
import { breadcrumbJsonLd } from '../../lib/seo';

const districts = liveIlceler();

const headJob = jobs.find((j) => j.id === 'dolmus-cadde') ?? jobs[0];
const headPhoto = await getImage({ src: headJob.image, width: 1600, format: 'webp' });

const jsonLd = [
  breadcrumbJsonLd(
    [
      { name: 'Ana sayfa', path: '/' },
      { name: 'İzmir', path: '/izmir/' },
    ],
    Astro.site,
  ),
].filter((entry): entry is object => entry !== null);
---
<BaseLayout
  title="İzmir İlçeleri Çekici ve Yol Yardım 7/24 | Ahmet Dadak"
  description="İzmir'de ilçeniz için çekici ve yol yardım sayfaları. Gece gündüz arayın ya da konumunuzu WhatsApp'tan gönderin."
  path="/izmir/"
  jsonLd={jsonLd}
>
  <header class="wrap head-panel" style={`--head-photo: url(${headPhoto.src})`}>
    <h1>İzmir ilçelerinde çekici</h1>
    <p class="lead">İzmir'in her ilçesine geliyoruz. İlçenize özel sayfalar:</p>
    <div class="actions">
      <PlateCall data-primary-cta />
      <WhatsAppButton />
    </div>
  </header>
  <section class="wrap list-wrap">
    <ul class="card-list">
      {
        districts.map((d) => (
          <li>
            <a href={ilcePath(d)}>{d.name} çekici</a>
          </li>
        ))
      }
    </ul>
  </section>
  <ContactBlock />
</BaseLayout>

<style>
  .list-wrap {
    padding-bottom: 44px;
  }

  h1 {
    margin: 0;
    font: 700 2.5rem/0.95 var(--font-display);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .lead {
    margin: 14px 0 0;
    max-width: 44ch;
    font-size: 1.125rem;
    line-height: 1.45;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 20px;
  }

  .actions :global(.plate) {
    display: flex;
  }

  .actions :global(.plate-face) {
    align-items: center;
    padding-inline: 12px;
  }

  .actions :global(.plate-digits) {
    font-size: clamp(1.75rem, 9.4vw, 2.125rem);
  }

  .actions :global(.wa-button) {
    display: flex;
    width: 100%;
  }

  @media (min-width: 768px) {
    h1 {
      font-size: 4rem;
    }

    .actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
    }

    .actions :global(.plate) {
      display: inline-flex;
    }

    .actions :global(.plate-face) {
      align-items: flex-start;
      padding-inline: 18px;
    }

    .actions :global(.plate-digits) {
      font-size: 2.5rem;
    }

    .actions :global(.wa-button) {
      display: inline-flex;
      width: auto;
    }
  }
</style>
