---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PlateCall from '../components/PlateCall.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ServiceLine from '../components/ServiceLine.astro';
import ReflectiveBand from '../components/ReflectiveBand.astro';
import parkBornova from '../assets/jobs/park-bornova.jpg';
import { business } from '../data/business';
import { localBusinessJsonLd } from '../lib/seo';

const services = [
  { label: 'Arıza' },
  { label: 'Kaza' },
  { label: 'Akü takviyesi' },
  { label: 'Lastik' },
  { label: 'Yakıt' },
  { label: 'Alkollüyseniz arayın' },
];

const jsonLd = [localBusinessJsonLd(business, ['İzmir'], Astro.site)];
---
<BaseLayout
  title="İzmir Çekici ve Yol Yardım 7/24 | Ahmet Dadak Yol Yardım"
  description="İzmir'in her ilçesinde gece gündüz çekici ve yol yardım. 0540 123 0335'i arayın ya da konumunuzu WhatsApp'tan gönderin; aracınızı istediğiniz yere bırakalım."
  path="/"
  jsonLd={jsonLd}
  ogImage={parkBornova}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">
        Yolda mı kaldınız? <em class="hero-where">Bulunduğunuz yere</em>{' '}<span class="hero-go">geliyoruz.</span>
      </h1>
      <p class="hero-lede">
        İzmir'in her ilçesinde gece gündüz çekici ve yol yardım. Arayın ya da konumunuzu
        WhatsApp'tan gönderin; aracınızı istediğiniz yere bırakalım.
      </p>
      <div class="hero-actions">
        <PlateCall data-primary-cta />
        <WhatsAppButton />
      </div>
      <div class="hero-services">
        <ServiceLine items={services} />
      </div>
    </div>
    <figure class="hero-photo">
      <Picture
        src={parkBornova}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[480, 768, 1080, 1500]}
        sizes="(min-width: 1024px) 52vw, 100vw"
        loading="eager"
        fetchpriority="high"
        alt="Gün batımında Park Bornova önü: siyah Peugeot 206, Dadak Yol Yardım çekicisinin kasasına bağlanmış."
      />
      <figcaption>
        <b>Park Bornova önü.</b><span class="caption-rest"> Peugeot 206 çekiciye alındı.</span>
      </figcaption>
    </figure>
    <ReflectiveBand />
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-areas:
      'photo'
      'band'
      'copy';
  }

  .hero-copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    padding: 18px 16px 30px;
  }

  .hero-photo {
    grid-area: photo;
    position: relative;
    height: clamp(210px, 46vw, 420px);
    margin: 0;
    overflow: hidden;
    background: #3a3328;
  }

  .hero > :global(.reflective-band) {
    grid-area: band;
  }

  .hero-photo :global(picture) {
    position: absolute;
    inset: 0;
  }

  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }

  figcaption {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 8px 14px 7px;
    background: var(--panel);
    border-top-right-radius: 6px;
    color: var(--ink);
    font: 500 0.8125rem/1.3 var(--font-body);
  }

  figcaption b {
    font-weight: 600;
  }

  .caption-rest {
    display: none;
  }

  h1 {
    margin: 0;
    font: 700 2.25rem/0.95 var(--font-display);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .hero-where {
    display: none;
    font-style: normal;
    color: var(--red);
  }

  .hero-go {
    color: var(--red);
  }

  .hero-lede {
    display: none;
    margin: 18px 0 0;
    max-width: 40ch;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 16px;
  }

  .hero-actions :global(.plate) {
    display: flex;
  }

  .hero-actions :global(.plate-face) {
    align-items: center;
    padding-inline: 12px;
  }

  .hero-actions :global(.plate-digits) {
    font-size: clamp(1.75rem, 9.4vw, 2.125rem);
  }

  .hero-actions :global(.wa-button) {
    display: flex;
    width: 100%;
    min-height: 52px;
  }

  .hero-services {
    margin-top: 18px;
  }

  .hero-services :global(.service-line) {
    font-size: 0.9375rem;
  }

  @media (min-width: 768px) {
    .hero-copy {
      padding: 36px 32px 40px;
    }

    h1 {
      font-size: 3.5rem;
      text-wrap: balance;
    }

    .hero-where {
      display: inline;
    }

    .hero-go {
      color: var(--ink);
    }

    .hero-lede {
      display: block;
    }

    .caption-rest {
      display: inline;
    }

    figcaption {
      padding: 9px 14px 8px;
    }

    .hero-actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      margin-top: 26px;
    }

    .hero-actions :global(.plate) {
      display: inline-flex;
    }

    .hero-actions :global(.plate-face) {
      align-items: flex-start;
      padding-inline: 18px;
    }

    .hero-actions :global(.plate-digits) {
      font-size: 2.5rem;
    }

    .hero-actions :global(.wa-button) {
      display: inline-flex;
      width: auto;
      min-height: 56px;
    }

    .hero-services {
      margin-top: 28px;
    }

    .hero-services :global(.service-line) {
      font-size: 1.0625rem;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: 1fr 1.08fr;
      grid-template-rows: minmax(max(430px, min(620px, calc(100svh - 190px))), auto) auto;
      grid-template-areas:
        'copy photo'
        'band band';
    }

    .hero-photo {
      height: auto;
    }

    .hero-photo :global(img) {
      object-position: center 58%;
    }

    .hero-copy {
      padding: clamp(40px, 5vh, 64px) 40px 34px 32px;
    }

    h1 {
      font-size: clamp(3.75rem, 5.6vw, 5.5rem);
    }

    .hero-lede {
      font-size: 1.0625rem;
    }

    .hero-services {
      margin-top: auto;
      padding-top: 28px;
    }
  }
  @media (min-width: 1600px) {
    .hero-copy {
      padding-left: max(32px, calc((100vw - 1600px) / 2 + 32px));
    }
  }
</style>
