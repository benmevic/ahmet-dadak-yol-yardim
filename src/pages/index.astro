---
import { Picture, getImage } from 'astro:assets';
import logo from '../assets/logo.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import PlateCall from '../components/PlateCall.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ServiceLine from '../components/ServiceLine.astro';
import JobStrip from '../components/JobStrip.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Faq from '../components/Faq.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { homeFaq } from '../data/home-faq';
import { priceFaq } from '../data/common-faq';
import parkBornova from '../assets/jobs/park-bornova.jpg';
import heroTruck from '../assets/cekici-yan-profil.jpg';
import { business } from '../data/business';
import { services as serviceList } from '../data/services';
import { faqJsonLd, localBusinessJsonLd } from '../lib/seo';
import { liveIlceler, ilcePath } from '../lib/ilce';

const faqItems = [homeFaq[0], priceFaq, ...homeFaq.slice(1)];

const services = [
  { label: 'Arıza', href: '/hizmetler/ariza-kurtarma/' },
  { label: 'Kaza', href: '/hizmetler/kaza-oto-kurtarma/' },
  { label: 'Akü takviyesi', href: '/hizmetler/aku-takviyesi/' },
  { label: 'Lastik', href: '/hizmetler/lastik-destegi/' },
  { label: 'Yakıt', href: '/hizmetler/yakit-destegi/' },
  { label: 'Alkollüyseniz arayın', href: '/hizmetler/alkollu-surucu-arac-tasima/' },
];

const logoImage = await getImage({ src: logo, width: 512, height: 512, format: 'png' });
const logoUrl = Astro.site ? new URL(logoImage.src, Astro.site).toString() : undefined;

const jsonLd = [
  localBusinessJsonLd(
    business,
    liveIlceler().map((i) => i.name),
    Astro.site,
    logoUrl,
    serviceList.map((s) => s.name),
  ),
  faqJsonLd(faqItems),
].filter((entry): entry is object => entry !== null);
---
<BaseLayout
  title="İzmir Oto Çekici ve Yol Yardım 7/24 | Ahmet Dadak Yol Yardım"
  description="İzmir'in her ilçesinde gece gündüz çekici ve yol yardım. 0540 123 0335'i arayın ya da konumunuzu WhatsApp'tan gönderin; aracınızı istediğiniz yere bırakalım."
  path="/"
  jsonLd={jsonLd}
  ogImage={parkBornova}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">
        Yolda mı kaldınız? <em class="hero-where">Bulunduğunuz yere</em>{' '}<span class="hero-go">geliyoruz.</span>
      </h1>
      <p class="hero-lede">
        İzmir'in her ilçesinde gece gündüz çekici ve yol yardım. Arayın ya da konumunuzu
        WhatsApp'tan gönderin; aracınızı istediğiniz yere bırakalım.
      </p>
      <div class="hero-actions">
        <PlateCall data-primary-cta />
        <WhatsAppButton />
      </div>
      <div class="hero-services">
        <ServiceLine items={services} />
      </div>
    </div>
    <figure class="hero-photo">
      <Picture
        src={heroTruck}
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        widths={[480, 768, 1080, 1500]}
        sizes="(min-width: 1024px) 52vw, 100vw"
        loading="eager"
        fetchpriority="high"
        alt="Ahmet Dadak Yol Yardım'ın beyaz kasalı çekicisi yandan, kasa rampası yere indirilmiş."
      />
      <figcaption>
        <b>Çekicimiz.</b><span class="caption-rest"> Fiat Ducato, kasa rampası açık.</span>
      </figcaption>
    </figure>
  </section>

  <JobStrip />

  <HowItWorks />

  <section id="hizmetler" class="services" aria-labelledby="services-title">
    <div class="wrap">
      <h2 id="services-title" class="section-title">Hizmetlerimiz</h2>
      <ul class="service-list">
        {
          serviceList.map((s) => (
            <li>
              <a href={`/hizmetler/${s.slug}/`}>{s.name}</a>
              <p>{s.lead}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="ilceler" class="districts" aria-labelledby="districts-title">
    <div class="wrap districts-inner">
      <h2 id="districts-title" class="section-title">İzmir'in her ilçesi</h2>
      <p>İzmir'in tüm ilçelerine 7/24 geliyoruz.</p>
      <ul class="districts-list">
        {
          liveIlceler().map((d) => (
            <li>
              <a href={ilcePath(d)}>{d.name} çekici</a>
            </li>
          ))
        }
      </ul>
      <a class="districts-link" href="/izmir/">Tüm ilçeler</a>
    </div>
  </section>

  <section class="drunk" aria-labelledby="drunk-title">
    <div class="wrap drunk-inner">
      <div class="drunk-copy">
        <h2 id="drunk-title">Alkollü araç kullanmayın, arayın</h2>
        <p>Aracınızı biz alalım, istediğiniz yere bırakalım.</p>
      </div>
      <PlateCall size="md" />
    </div>
  </section>

  <section id="sss" class="faq-section" aria-labelledby="faq-title">
    <div class="wrap">
      <h2 id="faq-title" class="section-title">Sık sorulanlar</h2>
      <div class="faq-wrap">
        <Faq items={faqItems} />
      </div>
    </div>
  </section>

  <ContactBlock />
</BaseLayout>

<style>
  .services {
    padding: 34px 0 38px;
    scroll-margin-top: 72px;
  }

  .service-list {
    display: grid;
    gap: 12px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .service-list li {
    position: relative;
    padding: 16px 18px 18px 22px;
    border-radius: 20px;
    background: linear-gradient(90deg, var(--red) 0 5px, var(--panel) 5px);
    box-shadow: var(--card-shadow);
    transition:
      transform var(--duration-fast) var(--ease-smooth-out),
      box-shadow var(--duration-fast) var(--ease-smooth-out);
  }

  /* The title link covers the whole card. */
  .service-list a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .service-list li:has(a:focus-visible) {
    outline: 3px solid var(--blue);
    outline-offset: 2px;
  }

  .service-list a:focus-visible {
    outline: none;
  }

  @media (hover: hover) {
    .service-list li:hover {
      transform: translateY(-2px);
      box-shadow: var(--card-shadow-lift);
    }
  }

  .service-list li:active {
    transform: translateY(0);
  }

  /* The hero photo settles into its frame once on load; the text and the
     call button never wait for it. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-photo :global(img) {
      animation: hero-settle 900ms var(--ease-smooth-out) both;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    h1,
    .hero-lede,
    .hero-services {
      animation: text-rise var(--duration-very-slow) var(--ease-smooth-out) both;
    }

    .hero-lede {
      animation-delay: 80ms;
    }

    .hero-services {
      animation-delay: 160ms;
    }

    /* The hero call plate breathes a soft red ring to draw the eye. */
    .hero-actions :global(.plate) {
      animation: call-ring 2.8s var(--ease-smooth-out) 1s infinite;
    }
  }

  @keyframes text-rise {
    from {
      opacity: 0;
      translate: 0 12px;
      filter: blur(3px);
    }
    to {
      opacity: 1;
      translate: 0 0;
      filter: none;
    }
  }

  @keyframes call-ring {
    0% {
      box-shadow: 0 0 0 0 rgb(246 201 104 / 0.7), 0 14px 28px -14px rgb(0 0 0 / 0.6);
    }
    70%,
    100% {
      box-shadow: 0 0 0 16px rgb(246 201 104 / 0), 0 14px 28px -14px rgb(0 0 0 / 0.6);
    }
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.05);
    }
    to {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-list li {
      transition: none;
    }
  }

  .service-list a {
    color: var(--ink);
    font: 700 1.25rem/1.15 var(--font-display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .service-list p {
    margin: 4px 0 0;
    max-width: 44ch;
    color: var(--muted);
    line-height: 1.45;
  }

  .districts {
    padding: 34px 0 38px;
    scroll-margin-top: 72px;
  }

  .districts-inner p {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 1.0625rem;
    line-height: 1.45;
  }

  .districts-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .districts-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    font: 700 1.25rem/1.15 var(--font-display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .districts-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 6px;
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .drunk {
    position: relative;
    overflow: hidden;
    margin: 10px 12px;
    padding: 30px 0 32px;
    border-radius: 24px;
    background: var(--night-panel);
    color: #fff;
    box-shadow: 0 30px 100px -34px rgb(220 35 41 / 0.55);
  }

  .drunk-inner {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .drunk h2 {
    margin: 0;
    font: 700 2rem/0.98 var(--font-display);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .drunk-copy p {
    margin: 10px 0 0;
    max-width: 36ch;
    color: #d8dadf;
    line-height: 1.45;
  }

  .faq-section {
    padding: 34px 0 38px;
    scroll-margin-top: 72px;
  }

  .faq-wrap {
    margin-top: 18px;
    max-width: 760px;
  }

  @media (min-width: 768px) {
    .services,
    .districts,
    .faq-section {
      padding-block: 52px 56px;
    }

    .service-list {
      grid-template-columns: 1fr 1fr;
      margin-top: 28px;
      gap: 26px 56px;
    }

    .drunk {
      margin: 16px 32px;
      padding-block: 52px;
      border-radius: 30px;
    }

    .drunk-inner {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 40px;
    }

    .drunk h2 {
      font-size: 3rem;
    }

    .faq-wrap {
      margin-top: 24px;
    }
  }

  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    margin: 4px 12px 0;
    border-radius: 24px;
    overflow: hidden;
    background: rgb(18 13 15);
    color: #fff;
    box-shadow: 0 30px 90px -40px rgb(0 0 0 / 0.9);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding: calc(clamp(220px, 64vw, 420px) - 40px) 16px 30px;
  }

  /* Phones: the photo sits across the top of the hero and fades into it. */
  .hero-photo {
    position: absolute;
    inset: 0 0 auto;
    height: clamp(220px, 64vw, 420px);
    z-index: 0;
    margin: 0;
    overflow: hidden;
  }

  /* Darkens the photo where the copy sits: the top stays bright on phones,
     the left side goes dark on wide screens. */
  .hero-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgb(18 13 15 / 0) 0%,
      rgb(18 13 15 / 0) 50%,
      rgb(18 13 15 / 0.75) 82%,
      rgb(18 13 15) 100%
    );
  }

  .hero-services :global(.service-line) {
    color: #fff;
  }

  .hero-services :global(.service-line a) {
    text-decoration-color: var(--gold-light);
  }

  .hero-services :global(.service-line li:not(:last-child)::after) {
    color: var(--gold-light);
  }

  .hero-photo :global(picture) {
    position: absolute;
    inset: 0;
  }

  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 52%;
  }

  figcaption {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    padding: 6px 11px 5px;
    background: var(--paper);
    border-radius: 8px;
    color: var(--paper-ink);
    font: 500 0.8125rem/1.3 var(--font-body);
  }

  figcaption b {
    font-weight: 600;
  }

  .caption-rest {
    display: none;
  }

  h1 {
    margin: 0;
    font: 700 2.25rem/0.95 var(--font-display);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #fff;
  }

  .hero-where {
    display: none;
    font-style: normal;
    color: var(--gold-light);
  }

  .hero-go {
    color: var(--gold-light);
  }

  .hero-lede {
    display: none;
    margin: 18px 0 0;
    max-width: 40ch;
    color: rgb(255 255 255 / 0.9);
    font-size: 1rem;
    line-height: 1.5;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 16px;
  }

  .hero-actions :global(.plate) {
    display: flex;
  }

  .hero-actions :global(.plate-face) {
    align-items: center;
    padding-inline: 12px;
  }

  .hero-actions :global(.plate-digits) {
    font-size: clamp(1.75rem, 9.4vw, 2.125rem);
  }

  .hero-actions :global(.wa-button) {
    display: flex;
    width: 100%;
    min-height: 52px;
  }

  .hero-services {
    margin-top: 18px;
  }

  .hero-services :global(.service-line) {
    font-size: 0.9375rem;
  }

  @media (min-width: 768px) {
    .hero-copy {
      padding: calc(clamp(220px, 64vw, 420px) - 40px) 32px 40px;
    }

    h1 {
      font-size: 3.5rem;
      text-wrap: balance;
    }

    .hero-where {
      display: inline;
    }

    .hero-go {
      color: #fff;
    }

    .hero {
      margin: 8px 32px 0;
      border-radius: 32px;
    }


    .hero-lede {
      display: block;
    }

    .caption-rest {
      display: inline;
    }

    figcaption {
      padding: 9px 14px 8px;
    }

    .hero-actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
      margin-top: 26px;
    }

    .hero-actions :global(.plate) {
      display: inline-flex;
    }

    .hero-actions :global(.plate-face) {
      align-items: flex-start;
      padding-inline: 18px;
    }

    .hero-actions :global(.plate-digits) {
      font-size: 2.5rem;
    }

    .hero-actions :global(.wa-button) {
      display: inline-flex;
      width: auto;
      min-height: 56px;
    }

    .hero-services {
      margin-top: 28px;
    }

    .hero-services :global(.service-line) {
      font-size: 1.0625rem;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-rows: minmax(max(430px, min(620px, calc(100svh - 190px))), auto);
    }

    .hero-copy {
      max-width: 50%;
      padding: clamp(44px, 6vh, 72px) 40px 40px 44px;
    }

    /* Wide screens: the photo sits on the right, its left edge melting into
       the dark hero behind the copy. */
    .hero-photo {
      inset: 0 0 0 36%;
      height: auto;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 26%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 26%);
    }

    .hero-photo::after {
      background: linear-gradient(0deg, rgb(18 13 15 / 0.5) 0%, rgb(18 13 15 / 0) 34%);
    }

    .hero-photo :global(img) {
      object-position: 40% 55%;
    }

    figcaption {
      top: auto;
      bottom: 26px;
      right: 18px;
    }

    h1 {
      font-size: clamp(3.75rem, 5.6vw, 5.5rem);
    }

    .hero-lede {
      font-size: 1.0625rem;
    }

    .hero-services {
      margin-top: auto;
      padding-top: 28px;
    }
  }
  @media (min-width: 1600px) {
    .hero-copy {
      padding-left: max(32px, calc((100vw - 1600px) / 2 + 32px));
    }
  }
</style>
